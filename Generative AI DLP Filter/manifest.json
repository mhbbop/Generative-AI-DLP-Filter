{
  "manifest_version": 3,
  "name": "Generative AI DLP Filter",
  "version": "1.1",
  "description": "Sistem deteksi data sensitif untuk layanan Generative AI (Gemini, ChatGPT, dan Claude).",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["contentScript.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_title": "DLP Settings",
    "default_popup": "popup.html"
  }
}